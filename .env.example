# Salin file ini menjadi .env lalu isi API key. JANGAN commit file .env.
# Provider: "anthropic" (default) atau "openai" (API yang kompatibel dengan OpenAI Chat Completions)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
# Opsional. Kosongkan untuk memakai URL bawaan provider.
AI_BASE_URL=
PORT=3000
# Batas pemakaian
RATE_LIMIT_PER_10_MIN=40
MAX_DAILY_AI_REQUESTS=1000
